{
    "workbench.colorCustomizations": {
        "tab.activeBackground": "#2E5F6B"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "window.restoreWindows": "none",
    "workbench.activityBar.orientation": "vertical",
    "workbench.iconTheme": "vscode-icons",
    "vsicons.dontShowNewVersionMessage": true,
    "extensions.autoUpdate": false,

    "editor.rulers": [120],
    "editor.renderWhitespace": "all",
    "editor.find.addExtraSpaceOnTop": false,
    "editor.largeFileOptimizations": false,
    "editor.wordSeparators": "、，。：，`~!@#$%^&*()（）-=+[{]}\\|;:'\",.<>/?",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.experimental.showMoves": true,
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[sql]": {
        "editor.defaultFormatter": "mtxr.sqltools"
    },

    "terminal.integrated.commandsToSkipShell": [
        "copy-file-name.copyFileNameWithExtension",
        "copyRelativeFilePath",
        "copyFilePath"
    ],
    "terminal.integrated.wordSeparators": "、，。：，` ()[]{}',\"`─‘’|:",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.enableVisualBell": true,
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },

    "remote.SSH.localServerDownload": "always",
    "remote.autoForwardPorts": false,

    "git.autofetch": true,
    "gitHistory.showFileHistorySplit": false,

    // 只保留与默认值不同的项，其余语言沿用 code-runner 默认
    "code-runner.executorMap": {
        "python": "python3",
        "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt -I/opt/homebrew/Cellar/protobuf/3.19.4/include/ -std=c++11 -L/opt/homebrew/Cellar/protobuf/3.19.4/lib/ -lprotobuf && $dir$fileNameWithoutExt"
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.runInTerminal": true,

    "python.createEnvironment.trigger": "off",
    "interactiveWindow.promptToSaveOnClose": true,
    "go.toolsManagement.autoUpdate": true,
    "cmake.configureOnOpen": false,

    // C/C++ 交给 clangd：关掉 cpptools 补全和灰显，clangd 不做半透明
    "clangd.inactiveRegions.opacity": 1,
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.dimInactiveRegions": false,

    "hediet.vscode-drawio.theme": "atlas",

    "cursor.cpp.disabledLanguages": ["scminput"],
    "cursor.chat.terminalShowHoverHint": false,

    "claude-notify.soundCountUnfocused": 2,
    "claude-notify.volume": 2,
    "claude-notify.dedupWindowSeconds": 10
}
